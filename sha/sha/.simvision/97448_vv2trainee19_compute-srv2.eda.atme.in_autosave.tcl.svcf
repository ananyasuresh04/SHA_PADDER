
#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set cursorctl-dont-show-sync-warning 1
preferences set toolbar-Standard-WaveWindow {
  usual
  position -pos 1
}
preferences set plugin-enable-groupscope 0
preferences set sb-display-values 1
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set whats-new-dont-show-at-startup 1

#
# Databases
#
database require sha256_512 -search {
	./sha256_512.shm/sha256_512.trn
	/home/vv2trainee19/Desktop/sha/sha/sha256_512.shm/sha256_512.trn
}

#
# Mnemonic Maps
#
mmap new -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1366x665+-1+27}] != ""} {
    window geometry "Waveform 1" 1366x665+-1+27
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ns \
    -valuewidth 107
waveform baseline set -time 0

set id [waveform add -signals  {
	sha256_512::tb_sha256_padder.uut.clk
	} ]
set id [waveform add -signals  {
	sha256_512::tb_sha256_padder.uut.rst_n
	} ]
set id [waveform add -signals  {
	sha256_512::tb_sha256_padder.uut.msg_valid
	} ]
set id [waveform add -signals  {
	sha256_512::tb_sha256_padder.uut.msg_stall
	} ]
set id [waveform add -signals  {
	sha256_512::tb_sha256_padder.uut.msg_last
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.msg_last_bytes[2:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.msg_data[63:0]}
	} ]
set id [waveform add -signals  {
	sha256_512::tb_sha256_padder.uut.final_block
	} ]
set id [waveform add -signals  {
	sha256_512::tb_sha256_padder.uut.block_valid
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk0_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk1_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk2_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk3_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk4_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk5_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk6_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk7_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk8_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk9_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk10_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk11_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk12_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk13_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk14_out[63:0]}
	} ]
set id [waveform add -signals  {
	{sha256_512::tb_sha256_padder.uut.blk15_out[63:0]}
	} ]

waveform xview limits 0 2000ns

#
# Waveform Window Links
#

#
# Source Browser windows
#
if {[catch {window new SrcBrowser -name "Source Browser 1" -geometry 1366x665+-1+27}] != ""} {
    window geometry "Source Browser 1" 1366x665+-1+27
}
window target "Source Browser 1" on
srcbrowser using {Source Browser 1}
srcbrowser set \
    -primarycursor TimeA \
    -units ns \
    -radix default \
    -showstrength 0 \
    -showcallstack 0 \
    -displayvalues 1

srcbrowser show -scope tb_sha256_padder.uut -file /home/vv2trainee19/Desktop/sha/sha/pad.v -line 2

srcbrowser sidebar visibility partial

#
# Console windows
#
console set -windowname Console
window geometry Console 600x250+0+0

